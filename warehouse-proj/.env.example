DB_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require&channelBinding=require
DB_USERNAME=your_user
DB_PASSWORD=your_password
JWT_SECRET=generate-with-openssl-rand-base64-64

# Optional: a test account to log in with locally
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=


# Optional: a viewer-role test account (create it on the Users page)
VIEWER_TEST_USER_EMAIL=
VIEWER_TEST_USER_PASSWORD=

# First admin account, created only on an empty database (8+ character password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local development only: write password reset links to the server log
LOG_RESET_LINKS=false
